# Local defaults. Keep real values in the environment.
APP_ENV=development
PUBLIC_APP_URL=http://127.0.0.1:8765
EMAIL_BACKEND=memory
MODEL_BACKEND=stub
AUTH_PEPPER=replace-with-a-long-random-value

# Opt-in categorical product signals. Collection still requires user consent.
PRODUCT_TELEMETRY_ENABLED=false
TELEMETRY_COHORT=beta
TELEMETRY_MIN_CELL_SIZE=3

# Production adds:
# DATABASE_URL=postgresql://...
# APP_ENV=production
# PUBLIC_APP_URL=https://your-toolkit-domain.example
# EMAIL_BACKEND=resend
# RESEND_API_KEY=...
# MAIL_FROM=Toolkit <accounts@your-verified-domain.example>
# MODEL_BACKEND=ollama
# OLLAMA_API_KEY=...
